# ===========================================
# DECENTRALIZED SIGNUP SYSTEM - ENV VARIABLES
# ===========================================

# --- Frontend (Vite) Variables ---
# These are exposed to the browser (must start with VITE_)

# Supabase Configuration (for client-side auth after signup)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL for email confirmations (your deployed Vercel URL)
VITE_SITE_URL=https://your-app.vercel.app

# API URL (optional - if different from site URL, e.g., custom domain)
# Leave empty to use same origin
VITE_API_URL=

# --- Backend (Serverless) Variables ---
# These are SECRET and only available in serverless functions

# Supabase Service Role Key (NEVER expose to frontend!)
# Get this from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase URL (same as above, for server-side use)
SUPABASE_URL=https://your-project.supabase.co

# Allowed origin for CORS (your production domain)
# Use * for development (not recommended for production)
ALLOWED_ORIGIN=https://your-app.vercel.app

# ===========================================
# SETUP INSTRUCTIONS:
# ===========================================
# 
# 1. Copy this file to .env (for local dev) or set in Vercel Dashboard
# 
# 2. In Vercel Dashboard (Production):
#    - Go to Project → Settings → Environment Variables
#    - Add ALL variables above
#    - Redeploy after adding
#
# 3. In Supabase Dashboard:
#    - Go to Authentication → URL Configuration
#    - Set Site URL to: https://your-app.vercel.app
#    - Add Redirect URL: https://your-app.vercel.app/login
#
# 4. Get Service Role Key:
#    - Supabase Dashboard → Project Settings → API
#    - Copy "service_role" key (NOT anon key!)
#    - Paste into SUPABASE_SERVICE_ROLE_KEY in Vercel
#
# ===========================================
# SECURITY WARNING:
# ===========================================
# NEVER commit the actual .env file with real values!
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend!
# The service role key bypasses all RLS policies!
# ===========================================
